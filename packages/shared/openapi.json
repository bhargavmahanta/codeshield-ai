            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "minimum": 1.0,
