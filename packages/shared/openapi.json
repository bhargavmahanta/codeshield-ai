          "column": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column"
          },
          "confidence_score": {
            "maximum": 1.0,
            "minimum": 0.0,
