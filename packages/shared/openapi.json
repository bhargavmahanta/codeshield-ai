      "AppliedReplacement": {
        "properties": {
          "data_category": {
            "$ref": "#/components/schemas/DataCategory"
          },
          "end": {
            "exclusiveMinimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/ProtectionMode"
          },
          "replacement": {
            "minLength": 1,
            "title": "Replacement",
            "type": "string"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "finding_id",
          "data_category",
          "start",
          "end",
          "replacement",
          "mode"
