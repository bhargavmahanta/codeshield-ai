  "info": {
    "description": "Local-only API. Raw sensitive values are never logged.",
    "title": "CodeShield AI Local Engine",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/llm/assess": {
      "post": {
        "description": "Assess structured content locally before an LLM trust-boundary crossing.",
        "operationId": "assess_for_llm_llm_assess_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LlmPreflightRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmAssessmentResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assess For Llm"
      }
    },
    "/llm/protect": {
      "post": {
        "description": "Protect eligible content locally; blocked requests return no content.",
        "operationId": "protect_for_llm_llm_protect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LlmPreflightRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
