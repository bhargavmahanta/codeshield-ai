        "type": "string"
      },
      "ContentSegment": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 1000000,
            "title": "Content",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SegmentKind"
          },
