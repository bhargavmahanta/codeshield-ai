{
  "name": "codeshield-ai",
  "version": "0.8.0",
  "private": true,
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "clean": "node scripts/clean-workspaces.mjs",
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "node scripts/run-workspace-command.mjs typecheck",
    "test": "node scripts/run-workspace-command.mjs test",
    "generate:contracts": "node scripts/generate-contracts.mjs --write",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "pack:check": "node scripts/run-workspace-command.mjs pack-check",
    "package:vsix": "npm run package:vsix --workspace packages/vscode-extension",
    "benchmark:vscode": "node scripts/benchmark-vscode.mjs",
    "benchmark:proxy": "python engine/scripts/benchmark_proxy.py",
    "demo:sdk": "npm run build && node packages/sdk/dist/demo.js"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.6"
  }
}
